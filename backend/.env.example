# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=localhost

# ── Database ─────────────────────────────────────────────────
# Local development:
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/digivirasat_dev

# ── Session ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_64_byte_random_hex_string

# ── Frontend ─────────────────────────────────────────────────
# Used for CORS allowlist and password reset/verification links
FRONTEND_URL=http://localhost:5173

# ── Email (Resend) ───────────────────────────────────────────
# Get your API key from https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# ── Storage ──────────────────────────────────────────────────
# Options: local (development), r2 (production)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads

