# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=localhost

# ── Database ─────────────────────────────────────────────────
# Neon PostgreSQL (Pooled endpoint for application queries):
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-tiny-wave-bdrbdlik-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon PostgreSQL (Direct endpoint for migrations and schema ops):
DATABASE_URL_DIRECT=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-tiny-wave-bdrbdlik.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional pool configuration:
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=10000

# ── Session ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_64_byte_random_hex_string

# ── Frontend & Application Domains ───────────────────────────
# Primary production domain is https://digivirasat.in
# Secondary domain digitalvirasat.in redirects (301) to digivirasat.in
APP_URL=https://digivirasat.in
FRONTEND_URL=https://digivirasat.in
# In local development:
# FRONTEND_URL=http://localhost:5173
# Optional cookie domain scoping (leave blank for default host-only scoping):
# COOKIE_DOMAIN=digivirasat.in

# ── Email (Resend) ───────────────────────────────────────────
# Get your API key from https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
# Dedicated verified sending domain in Resend: mail.digivirasat.in
RESEND_FROM_EMAIL=DigiVirasat <no-reply@mail.digivirasat.in>
SUPPORT_INBOX_EMAIL=fraxard@gmail.com

# ── Storage ──────────────────────────────────────────────────
# Options: local (development), r2 (production)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=digivirasat-vault
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_REGION=auto

# ── Razorpay ─────────────────────────────────────────────────
# Get your API keys from Razorpay Dashboard: Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
