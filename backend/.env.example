# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=localhost

# ── Database ─────────────────────────────────────────────────
# Local development:
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/digivirasat_dev

# ── Session ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_64_byte_random_hex_string

# ── Frontend ─────────────────────────────────────────────────
# Used for CORS allowlist and password reset/verification links
FRONTEND_URL=http://localhost:5173

